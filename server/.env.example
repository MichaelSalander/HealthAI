# HealthAI backend local configuration
PORT=8787
HOST=127.0.0.1
NODE_ENV=development
HEALTHAI_SESSION_SECRET=replace-with-a-long-random-secret
HEALTHAI_SESSION_TTL_SECONDS=86400
HEALTHAI_CORS_ORIGIN=http://localhost:5175
HEALTHAI_DB=sqlite
HEALTHAI_DB_FILE=./server/healthai.sqlite
# Hosted environments can use PostgreSQL instead of a local file:
# HEALTHAI_DB=postgres
# HEALTHAI_DATABASE_URL=postgresql://user:password@host:5432/healthai
# HEALTHAI_DB_SSL=true
HEALTHAI_UPLOAD_DIR=./server/uploads
# 生产环境必须配置 JSON 账号数组；建议使用 passwordHash（scrypt），不要保存明文密码
HEALTHAI_OPERATOR_ACCOUNTS_JSON=[{"id":"admin-001","role":"admin","name":"管理员","username":"admin","password":"change-me"},{"id":"c-101","role":"consultant","name":"陈晨","username":"c-101","password":"change-me"}]

# Future external providers. Keep real values in a local .env file only.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TEST_MODE=false
WECHAT_TEST_CUSTOMER_ID=u-001
WECHAT_TEST_CONSULTANT_ID=c-101
WECHAT_MCH_ID=
WECHAT_API_KEY=
OCR_PROVIDER=mock
OCR_API_KEY=
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=30000
PUSH_PROVIDER=
PUSH_API_KEY=
VOICE_PROVIDER=
VOICE_API_KEY=
