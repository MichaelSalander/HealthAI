# C 端正式构建环境变量。复制为 .env.production 后再替换实际域名。
VITE_API_BASE_URL=https://api.your-domain.com/api/v1
# 建議建立兩個前端入口：app.example.com 填 customer；consultant.example.com 填 consultant。
# 若使用同一份產物，可省略此值，程式會依 app./member./consultant./coach. 子網域判斷。
VITE_PORTAL_ROLE=customer
VITE_AUTH_MODE=email
HEALTHAI_CUSTOMER_ACCOUNTS_JSON=[{"id":"customer-001","username":"your-account","passwordHash":"your-scrypt-hash","name":"客户"}]
# DeepSeek 同时用于健康分析和体检报告 OCR；图片 OCR 使用 deepseek-flash 的视觉输入。
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=请在部署平台的密钥环境变量中填写
LLM_TIMEOUT_MS=60000
OCR_PROVIDER=deepseek
OCR_BASE_URL=https://api.deepseek.com
OCR_API_KEY=请在部署平台的密钥环境变量中填写
OCR_TIMEOUT_MS=120000
OCR_MODEL=deepseek-flash
OCR_ENABLE_VISION=true
OCR_PDF_RENDERER=pdftoppm
OCR_MAX_PAGES=20
OCR_IMAGE_DPI=144
# 正式环境必须关闭 Mock Provider；测试资料可以保留，但 AI/OCR 请求不再走 Mock。
HEALTHAI_ALLOW_MOCK_PROVIDERS=false
