{
  "name": "ai-health-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:local": "node tools/start-local.mjs",
    "test:consultation": "node --test server/consultation-workflow.test.mjs",
    "test:api": "node --test server/mock-api.integration.test.mjs",
    "test:production": "node --test server/production-readiness.test.mjs",
    "dev:h5": "uni -p h5",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:api": "node tools/run-api.mjs",
    "reset:local-data": "node tools/reset-local-data.mjs",
    "start:api": "node tools/run-api.mjs",
    "build:h5": "node node_modules/@dcloudio/vite-plugin-uni/bin/uni.js build -p h5",
    "build:mp-weixin": "node node_modules/@dcloudio/vite-plugin-uni/bin/uni.js build -p mp-weixin",
    "build:mp-weixin:test": "node tools/build-mp-weixin-test.mjs",
    "build:mp-weixin:production": "node tools/build-mp-weixin-production.mjs",
    "typecheck": "vue-tsc --noEmit",
    "preview:h5": "node tools/serve-dist.cjs",
    "doctor": "node tools/verify-environment.cjs",
    "verify:production": "node tools/verify-production.mjs",
    "hash:operator": "node tools/hash-operator-password.mjs",
    "verify:release": "pnpm run doctor && pnpm run typecheck && pnpm test:consultation && pnpm test:api && pnpm test:production && pnpm run build:h5 && pnpm --dir console run typecheck && pnpm --dir console run build",
    "verify": "pnpm run doctor && pnpm run typecheck && pnpm run build:h5"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4060620250520001",
    "@dcloudio/uni-h5": "3.0.0-4060620250520001",
    "@dcloudio/uni-ui": "^1.5.12",
    "@vue/reactivity": "3.4.21",
    "@vue/runtime-core": "3.4.21",
    "@vue/runtime-dom": "3.4.21",
    "pdfjs-dist": "4.10.38",
    "pg": "8.16.3",
    "sql.js": "^1.15.1",
    "vue": "3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.32",
    "@dcloudio/uni-components": "3.0.0-4060620250520001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4060620250520001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4060620250520001",
    "immutable": "4.3.7",
    "sass": "1.77.8",
    "typescript": "^5.7.3",
    "vite": "^5.2.8",
    "vue-tsc": "^2.2.8"
  }
}
